for_each(t.player, c.players, {
    !t.player.player.has_tag('BattleTowerReady') ? { t.fail = 1; break };
});
t.fail ? return 0;

q.length(c.player_losers) == 0 ? { v.won = true } : { v.won = false };

v.players = q.array();
for_each(t.player, c.players, {
    q.set_query('player', t.player.player);
    q.append(v.players, q.player);

    'Run victory music';
    v.won ? {
        t.battle_result = q.player.data.sound.mus_battle == 15 ? 7 : 1;
        q.run_script('battle_end', t.battle_result);
    } : {
        q.run_script('fade_battle_music');
    };
});

v.won ? v.players.0.data.temp.npc.walk_to(902, math.floor(v.players.0.data.temp.npc.y) + 0.0625, 68, 0.5);
q.run_molang('q.run_script(\'johto:post_battle\')', 2);
