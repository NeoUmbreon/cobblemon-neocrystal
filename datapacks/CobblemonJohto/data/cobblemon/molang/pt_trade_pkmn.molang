c.arg_1 == 0 || c.arg_2 == 0 ? return 0;
q.player == 0 || q.npc == 0 ? return 0;
t.requested = c.arg_1;
t.given = c.arg_2;

'Finds Pokemon of matching name in party and transacts trade';
t.party_pokemon = q.player.party.find_by_properties(t.requested);
t.found = 0;

t.party_pokemon != 0 ? {
    t.level = ' level='+t.party_pokemon.level;
    t.item = q.to_string(t.party_pokemon.held_item.item);
    t.item != 'minecraft:air' ? q.run_command('execute as ' + q.player.username + ' run give @s ' + t.item);
    q.player.party.remove_by_id(t.party_pokemon.id);
    q.player.party.add_by_properties(t.given + t.level + ' shiny=no');
    q.run_command('execute as ' + q.player.username + ' run function johto:sound/playlocalsfx {sfx:"pokemontraded"}');
    t.found = 1;
};

return t.found;