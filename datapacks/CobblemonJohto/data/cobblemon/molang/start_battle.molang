'load data';
q.set_query('config', q.player.world.server.data);

t.trainers = q.file.load('data/molang/trainers.json');
q.set_query('class', q.get_variable(q.split_string(q.npc.class,'cobblemon:'), '1'));
q.set_query('trainer_data', q.get_variable(t.trainers, q.class));

'start battle';
'if challenge_mode_disabled, or challenge mode script fails, uses npc entity party';
q.set_query('format', q.is_blank(q.trainer_data.doubles_id) ? 'singles' : 'doubles');
q.config.challenge_mode_disabled || !q.run_script('johto:instantiate_rctapi_trainer') ? q.npc.start_battle(q.player, q.format);

q.player.remove_tag('InDialogue');

'something went very wrong';
!q.player.in_battle ? {
    q.player.data.sound.mus_battle = 0;
    q.run_script('fade_music');
    return 0;
};

'do player stuff';
q.player.data.battle.whiteout_on_disconnect = q.trainer_data.no_autobattle;
q.player.data.battle.x = (q.player.x + q.npc.x) / 2;
q.player.data.battle.y = q.npc.y;
q.player.data.battle.z = (q.player.z + q.npc.z) / 2;
q.player.data.battle.max_battle_distance = (q.is_blank(q.trainer_data.challenge_distance) ? q.config.default_challenge_distance : q.trainer_data.challenge_distance);
q.run_script('request_battle_music', c.arg_1);
