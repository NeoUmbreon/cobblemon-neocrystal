t.battle_result = c.arg_1;
t.prefix = q.player.has_tag('DSSound') ? 'ds' : 'gb';
q.player.data.sound.battlemus = 0;

'lol';
!q.player.has_tag('AllGyms') ? {
    q.player.has_tag('Falkner') &&
    q.player.has_tag('Bugsy') &&
    q.player.has_tag('Whitney') &&
    q.player.has_tag('Morty') &&
    q.player.has_tag('Chuck') &&
    q.player.has_tag('Jasmine') &&
    q.player.has_tag('Pryce') &&
    q.player.has_tag('Clair') &&
    q.player.has_tag('Brock') &&
    q.player.has_tag('Misty') &&
    q.player.has_tag('Surge') &&
    q.player.has_tag('Erika') &&
    q.player.has_tag('Janine') &&
    q.player.has_tag('Sabrina') &&
    q.player.has_tag('Blaine') &&
    q.player.has_tag('Blue') ? {
        q.run_command('advancement grant ' + q.player.username + ' only johto:badges/allbadges');
        q.player.add_tag('AllGyms');
    };
};

t.battle_result == 1 ? {
    return q.run_script('force_music', t.prefix + '/victory/trainer');
};

t.battle_result == 2 || t.battle_result == 3 ? {
    return q.run_script('force_music', t.prefix + '/victory/gymleader');
};

t.battle_result == 4 ? {
    return q.run_script('play_oneshot_as_music', t.prefix + '/victory/wildpokemon', 4, 1000);
};

t.battle_result == 5 ? {
    return q.run_script('play_oneshot_as_music', t.prefix + '/victory/wildpokemonshort', 4, 1000);
};

'pvp';
t.battle_result == 6 ? {
    return q.run_script('play_oneshot_as_music', t.prefix + '/victory/trainer', 4, 1000);
};

t.battle_result == 7 ? {
    return q.run_script('force_music', 'ds/victory/frontierbrain');
};
