{
    "initializationAction": [
        "q.run_script('request_music_change', (q.player.has_tag('DSSound') ? 'ds' : 'gb') + '/npc/hurryalong', 3, -1);",
        "q.player.add_tag('InDialogue');"
    ],
    "escapeAction": [],
    "speakers": {
        "npc": {
            "name": "Mom",
            "face": {
                "type": "artificial",
                "modelType": "npc",
                "identifier": "cobblemon:oldlady",
                "isLeftSide": true
            }
        },
        "player": {
            "face": "q.player.face();",
            "name": {
                "type": "expression",
                "expression": "q.player.username"
            }
        }
    },
    "pages": [
        {
            "id": "greeting",
            "speaker": "npc",
            "lines": [
                "Oh, you're up!"
            ],
            "input": {
                "type": "option",
                "vertical": false,
                "options": [
                    {
                        "text": "Next",
                        "value": "next",
                        "action": "q.dialogue.set_page('page2');"
                    }
                ]
            }
        },
        {
            "id": "page2",
            "speaker": "npc",
            "lines": [
                "Our neighbor, Professor Elm, was looking for you."
            ],
            "input": {
                "type": "option",
                "vertical": false,
                "options": [
                    {
                        "text": "Next",
                        "value": "next",
                        "action": "q.dialogue.set_page('page3');"
                    }
                ]
            }
        },
        {
            "id": "page3",
            "speaker": "npc",
            "lines": [
                "He said he wanted you to do something for him."
            ],
            "input": {
                "type": "option",
                "vertical": false,
                "options": [
                    {
                        "text": "Close",
                        "value": "close",
                        "action": [
                            "q.dialogue.close();",
                            "q.run_script('fade_dialogue_music');",
                            "q.player.add_tag('Dialogue2');",
                            "q.player.remove_tag('InDialogue');"
                        ]
                    }
                ]
            }
        }
    ]
}