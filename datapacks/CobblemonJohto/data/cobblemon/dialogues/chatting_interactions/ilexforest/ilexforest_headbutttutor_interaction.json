{
    "initializationAction": [
        "v.page_length = 3;"
    ],
    "speakers": {
        "npc": {
            "name": {
                "type": "expression",
                "expression": "q.npc.name"
            },
            "face": "q.npc.face"
        },
        "none": {
            "name": " "
        }
    },
    "pages": [
        {
            "id": "greeting",
            "speaker": "npc",
            "lines": [
                "What am I doing?"
            ],
            "input": {
                "type": "option",
                "vertical": false,
                "options": [
                    {
                        "text": "Next",
                        "value": "next",
                        "action": "q.dialogue.next_page;"
                    }
                ]
            }
        },
        {
            "id": "greeting2",
            "speaker": "npc",
            "lines": [
                "I'm shaking trees using Headbutt."
            ],
            "input": {
                "type": "option",
                "vertical": false,
                "options": [
                    {
                        "text": "Next",
                        "value": "next",
                        "action": "q.dialogue.next_page;"
                    }
                ]
            }
        },
        {
            "id": "greeting3",
            "speaker": "npc",
            "lines": [
                "It's fun. Here, you try it with your Pokémon, too!"
            ],
            "input": {
                "type": "option",
                "vertical": false,
                "options": [
                    {
                        "text": "Yes",
                        "value": "yes",
                        "action": [
                            "v.max_party_index = v.page_length * math.ceil(q.player.party.count / v.page_length);",
                            "q.dialogue.next_page;"
                        ]
                    },
                    {
                        "text": "No",
                        "value": "no",
                        "action": "q.dialogue.set_page('leave');"
                    }
                ]
            }
        },
        {
            "id": "partylist",
            "speaker": "npc",
            "lines": [
                "Which Pokémon should learn it?"
            ],
            "input": {
                "type": "option",
                "vertical": true,
                "options": [
                    {
                        "value": "page_forward",
                        "text": {
                            "type": "expression",
                            "expression": "'Page ' + (v.party_index / v.page_length + 1) + ' / ' + (v.max_party_index / v.page_length) + ' >>';"
                        },
                        "isVisible": "q.player.party.count > v.page_length + 1;",
                        "action": [
                            "v.party_index = v.party_index + v.page_length; v.party_index >= v.max_party_index ? { v.party_index = 0 };",
                            "q.dialogue.set_page('partylist');"
                        ]
                    },
                    {
                        "value": "sel0",
                        "text": {
                            "type": "expression",
                            "expression": "t.poke = q.player.party.pokemon.[v.party_index + 0]; t.poke.species.name == 0 ? return '' : return t.poke.species.name;"
                        },
                        "isVisible": "q.player.party.count > 0;",
                        "isSelectable": "q.player.party.pokemon.[v.party_index + 0] != 0",
                        "action": [
                            "q.set_query('pokemon', q.player.party.pokemon.[v.party_index + 0]);",
                            "q.run_script('pkmn_has_learned', q.pokemon, 'headbutt') ? return q.dialogue.set_page('haslearned');",
                            "q.dialogue.set_page(q.pokemon.can_learn_move('headbutt') ? 'confirmation' : 'cantlearn');"
                        ]
                    },
                    {
                        "value": "sel1",
                        "text": {
                            "type": "expression",
                            "expression": "t.poke = q.player.party.pokemon.[v.party_index + 1]; t.poke.species.name == 0 ? return '' : return t.poke.species.name;"
                        },
                        "isVisible": "q.player.party.count > 1;",
                        "isSelectable": "q.player.party.pokemon.[v.party_index + 1] != 0",
                        "action": [
                            "q.set_query('pokemon', q.player.party.pokemon.[v.party_index + 1]);",
                            "q.run_script('pkmn_has_learned', q.pokemon, 'headbutt') ? return q.dialogue.set_page('haslearned');",
                            "q.dialogue.set_page(q.pokemon.can_learn_move('headbutt') ? 'confirmation' : 'cantlearn');"
                        ]
                    },
                    {
                        "value": "sel2",
                        "text": {
                            "type": "expression",
                            "expression": "t.poke = q.player.party.pokemon.[v.party_index + 2]; t.poke.species.name == 0 ? return '' : return t.poke.species.name;"
                        },
                        "isVisible": "q.player.party.count > 2;",
                        "isSelectable": "q.player.party.pokemon.[v.party_index + 2] != 0",
                        "action": [
                            "q.set_query('pokemon', q.player.party.pokemon.[v.party_index + 2]);",
                            "q.run_script('pkmn_has_learned', q.pokemon, 'headbutt') ? return q.dialogue.set_page('haslearned');",
                            "q.dialogue.set_page(q.pokemon.can_learn_move('headbutt') ? 'confirmation' : 'cantlearn');"
                        ]
                    },
                    {
                        "value": "selend",
                        "text": {
                            "type": "expression",
                            "expression": "t.poke = q.player.party.pokemon.[v.page_length]; t.poke.species.name == 0 ? return '' : return t.poke.species.name;"
                        },
                        "isVisible": "q.player.party.count - 1 == v.page_length;",
                        "action": [
                            "q.set_query('pokemon', q.player.party.pokemon.[v.page_length]);",
                            "q.run_script('pkmn_has_learned', q.pokemon, 'headbutt') ? return q.dialogue.set_page('haslearned');",
                            "q.dialogue.set_page(q.pokemon.can_learn_move('headbutt') ? 'confirmation' : 'cantlearn');"
                        ]
                    },
                    {
                        "text": "Exit",
                        "value": "exit",
                        "action": "q.dialogue.set_page('leave');"
                    }
                ]
            }
        },
        {
            "id": "confirmation",
            "speaker": "none",
            "lines": [
                {
                    "type": "expression",
                    "expression": "t.headbutt = q.get_move_from_id('headbutt'); return t.headbutt.display_name + ': ' + t.headbutt.description"
                }
            ],
            "input": {
                "type": "option",
                "vertical": true,
                "options": [
                    {
                        "text": {
                            "type": "expression",
                            "expression": "'Teach ' + q.pokemon.species.name"
                        },
                        "value": "teach",
                        "action": [
                            "q.pokemon.teach_move('headbutt');",
                            "q.run_command('execute as ' + q.player.username + ' run function johto:sound/playlocalsfx {sfx:\"levelup\"}');",
                            "q.dialogue.next_page;"
                        ]
                    },
                    {
                        "text": "Back",
                        "value": "back",
                        "action": "q.dialogue.set_page('partylist');"
                    }
                ]
            }
        },
        {
            "id": "success",
            "speaker": "none",
            "lines": [
                {
                    "type": "expression",
                    "expression": "q.pokemon.species.name + ' learned Headbutt!'"
                }
            ],
            "input": {
                "type": "option",
                "vertical": false,
                "options": [
                    {
                        "text": "Next",
                        "value": "next",
                        "action": "q.dialogue.set_page('learned');"
                    }
                ]
            }
        },
        {
            "id": "learned",
            "speaker": "npc",
            "lines": [
                "There. How do you like it?",
                {
                    "type": "expression",
                    "expression": "'Your ' + q.pokemon.species.name + ' looks stronger!'"
                }
            ],
            "input": {
                "type": "option",
                "vertical": false,
                "options": [
                    {
                        "text": "Close",
                        "value": "close",
                        "action": "q.dialogue.close;"
                    }
                ]
            }
        },
        {
            "id": "cantlearn",
            "speaker": "npc",
            "lines": [
                "Sorry...",
                "That Pokémon cannot learn Headbutt."
            ],
            "input": {
                "type": "option",
                "vertical": false,
                "options": [
                    {
                        "text": "Back",
                        "value": "back",
                        "action": "q.dialogue.set_page('partylist');"
                    }
                ]
            }
        },
        {
            "id": "haslearned",
            "speaker": "npc",
            "lines": [
                {
                    "type": "expression",
                    "expression": "'Your ' + q.pokemon.species.name + ' has already learned Headbutt.'"
                }
            ],
            "input": {
                "type": "option",
                "vertical": false,
                "options": [
                    {
                        "text": "Back",
                        "value": "back",
                        "action": "q.dialogue.set_page('partylist');"
                    }
                ]
            }
        },
        {
            "id": "leave",
            "speaker": "npc",
            "lines": [
                "I see...",
                "Take care of its head."
            ],
            "input": {
                "type": "option",
                "vertical": false,
                "options": [
                    {
                        "text": "Close",
                        "value": "close",
                        "action": "q.dialogue.close;"
                    }
                ]
            }
        }
    ]
}